extends ../layout

block content

    h1 Publicaciones de usuarios que sigo

    p Usuario logueado: #{usuario.nombre}

    if usuariosSeguidos.length === 0
        p Todavía no seguís a ningún usuario.
        a(href="/seguimientos") Buscar usuarios para seguir

    else
        h2 Usuarios seguidos

        each u in usuariosSeguidos
            div.publicacion
                h3= u.nombre
                p Email: #{u.email}

        hr

        if publicaciones && publicaciones.length > 0
            h2 Publicaciones de usuarios que sigo

            each publicacion in publicaciones
                div.publicacion
                    h3= publicacion.titulo
                    p Autor: #{publicacion.autor}
                    p Categoria: #{publicacion.categoria}

                    if publicacion.imagenes && publicacion.imagenes.length > 0
                        img(src=publicacion.imagenes[0] alt="Imagen de la publicación" width="200")

                    br
                    a(href=`/publicaciones/${publicacion.id}`) Ver detalle

        else
            p Los usuarios que seguís todavía no tienen publicaciones.

    br
    a(href="/seguimientos") Volver a seguimientos