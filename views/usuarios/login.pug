extends ../layout

block content 
    h2 iniciar sesion 

    if mensajeRegistro 
        p.alerta= mensajeRegistro 
    form(action="/usuarios/login" method="post") 

        div 
            label(for="email") Email: 
            input(type="email" name="email")
        div 
            label(for="password") Password: 
            input(type="password" name="password")
        div     
            button(type="submit") Inicio sesion
        div 
            p ¿No tenés cuenta?
            a(href="/usuarios/registro") Registrate                
        
