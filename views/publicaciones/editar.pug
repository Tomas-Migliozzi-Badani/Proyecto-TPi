extends ../layout

block content
  section.formulario-publicacion
    div.formulario-card
      h1 Editar publicación
      p.formulario-subtitulo Modificá los datos de tu publicación.

      form(action=`/publicaciones/${publicacion.id}/editar` method="POST")
        div.campo-form
          label(for="titulo") Título
          input(type="text" name="titulo" id="titulo" value=publicacion.titulo required)

        div.campo-form
          label(for="categoria") Categoría
          input(type="text" name="categoria" id="categoria" value=publicacion.categoria required)

        div.campo-form
          label(for="descripcion") Descripción
          textarea(name="descripcion" id="descripcion")= publicacion.descripcion

        div.acciones-formulario
          a.btn-secundario(href=`/publicaciones/${publicacion.id}`) Cancelar
          button.btn-principal(type="submit") Guardar cambios