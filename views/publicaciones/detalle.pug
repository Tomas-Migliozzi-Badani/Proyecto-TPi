extends ../layout 

block content 

    div
        h1= publicacion.titulo 
        p Autor: #{publicacion.autor}
        p Categoria: #{publicacion.categoria} 
        p Descripcion: #{publicacion.descripcion} 
        if publicacion.imagenes && publicacion.imagenes.length > 0
            h3 Imagen
            each imagen in publicacion.imagenes
                img(src=imagen alt="Imagen de la publicación" width="350")
        else
            p Esta publicación no tiene imagen cargada.
        div 
            p Valoración promedio: #{publicacion.valoraciones || 0}
            p Cantidad de valoraciones: #{publicacion.cantidadValoracion || 0}
        if usuario && usuario.id !== publicacion.autorId
            form(action=`/publicaciones/${publicacion.id}/valorar` method="POST")
                label(for="puntaje") Valorá esta publicación:
                select(name="puntaje" id="puntaje" required)
                    option(value="5") 5 estrellas
                    option(value="4") 4 estrellas
                    option(value="3") 3 estrellas
                    option(value="2") 2 estrellas
                    option(value="1") 1 estrella
                button(type="submit") Guardar valoración

        if usuario && usuario.id === publicacion.autorId
            br
            a(href=`/publicaciones/${publicacion.id}/editar`) Editar
            form(action=`/publicaciones/${publicacion.id}/eliminar` method="POST")
                button(type="submit") Eliminar publicacion 
            br 
            a(href="/publicaciones") Volver al menu  
     

    h2 Comentarios 

    if comentarios.length === 0
        p No hay comentarios todavia  

    each comentario in comentarios
        div.comentario 
            strong= comentario.autor     
            p= comentario.texto
            hr
    h3 Agregar comentario 

    form(action=`/publicaciones/${publicacion.id}/comentarios` method="POST")

        div 
            label(for="autor")  Autor
            input(type="text" name="autor")  
        div 
            label(for="texto")  Comentario
            textarea(type="text" name="texto")
        button(type="submit") Comentar 

