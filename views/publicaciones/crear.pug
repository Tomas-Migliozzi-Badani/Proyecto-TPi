doctype html
html(lang="es")
    head
        title Crear publicacion - Fotaza 2
    body 
        h1 Crear nueva publicacion 

        form(action="/publicaciones/crear" method="POST")
            div  
                label(for="titulo") Titulo: 
                input(type="text" name="titulo" id="titulo" required) 
            div 
                label(for="autor") Autor: 
                input(type="text" name="autor" id="autor" required)  
            div 
                label(for="categoria") Categoria: 
                textarea(name="categoria" id="categoria" required) 

            div 
                label(for="descripcion") Descripcion: 
                textarea(name="descripcion" id="descripcion")     
            div     
                label(for="imagen") Imagen
                input(type="file" id="imagen" accept="image/*")

                input(type="hidden" name="imagenBase64" id="imagenBase64")

                img(id="previewImagen" width="250")

            button(type="submit") Crear Publicacion 

        br
        a(href="/publicaciones") volver a las publicaciones     

    script.
        const inputImagen = document.getElementById("imagen");
        const inputBase64 = document.getElementById("imagenBase64");
        const previewImagen = document.getElementById("previewImagen");

        inputImagen.addEventListener("change", function () {
            const archivo = inputImagen.files[0];

            if (!archivo) {
                return;
            }

            const lector = new FileReader();

            lector.onload = function () {
                inputBase64.value = lector.result;
                previewImagen.src = lector.result;
            };

            lector.readAsDataURL(archivo);
            });